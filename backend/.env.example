DATABASE_URL=postgres://user:password@localhost:5432/club_finance
JWT_SECRET=change-me-to-a-long-random-string
INVITE_CODE=change-me
PORT=4000

# Admin sign-in (used until the admin saves new details on the admin Settings page,
# after which the database copy takes over). Generate the hash with:
#   npm run admin:hash -- "your-password"
# Wrap the hash in single quotes in .env — it contains $ characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH='$2a$12$replace-with-output-of-npm-run-admin-hash'
# Optional: separate signing secret for admin sessions (defaults to JWT_SECRET + ":admin")
# ADMIN_JWT_SECRET=
